#!/usr/bin/env qore
%modern
%requires QUnit
%requires krb5
%requires Krb5Util

%exec-class Krb5ModuleTest

public class Krb5ModuleTest inherits QUnit::Test {
    constructor() : Test("Krb5ModuleTest", "1.0") {
        addTestCase("utility module helpers", \testUtilityModuleHelpers());
        addTestCase("utility parse host-based service principal",
            \testUtilityParseHostBasedServicePrincipal());
        addTestCase("utility parse rejects single-component principal",
            \testUtilityParseHostBasedServicePrincipalRejectsSingleComponent());
        addTestCase("utility parse rejects malformed principal",
            \testUtilityParseHostBasedServicePrincipalRejectsMalformed());
        addTestCase("utility tls-server-end-point channel binding builder",
            \testUtilityBuildTlsServerEndPointChannelBindingHex());
        addTestCase("context defaults", \testContextDefaults());
        addTestCase("default credential cache metadata", \testDefaultCredentialCacheMetadata());
        addTestCase("default keytab metadata", \testDefaultKeytabMetadata());
        addTestCase("credentials metadata", \testCredentialsMetadata());
        addTestCase("credentials default optional fields", \testCredentialsDefaultOptionalFields());
        addTestCase("credentials invalid key hex rejected", \testCredentialsInvalidKeyHexRejected());
        addTestCase("credentials empty key rejected", \testCredentialsEmptyKeyRejected());
        addTestCase("credentials invalid ticket hex rejected", \testCredentialsInvalidTicketHexRejected());
        addTestCase("credential cache store and list", \testCredentialCacheStoreAndList());
        addTestCase("memory credential cache roundtrip", \testMemoryCredentialCacheRoundtrip());
        addTestCase("empty credential cache reports no principal", \testEmptyCredentialCache());
        addTestCase("empty cache name rejected", \testEmptyCacheNameRejected());
        addTestCase("file cache sandbox deny", \testFileCacheSandboxDeny());
        addTestCase("file cache sandbox allow", \testFileCacheSandboxAllow());
        addTestCase("memory keytab roundtrip", \testMemoryKeytabRoundtrip());
        addTestCase("memory keytab highest kvno", \testMemoryKeytabHighestKvno());
        addTestCase("invalid keytab hex rejected", \testInvalidKeytabHexRejected());
        addTestCase("file keytab sandbox deny", \testFileKeytabSandboxDeny());
        addTestCase("file keytab sandbox allow", \testFileKeytabSandboxAllow());
        addTestCase("principal parsing", \testPrincipalParsing());
        addTestCase("enterprise principal parsing", \testEnterprisePrincipalParsing());
        addTestCase("principal copy and equality", \testPrincipalCopy());
        addTestCase("principal component bounds", \testPrincipalBounds());
        addTestCase("initial credentials empty password rejected", \testInitialCredentialsEmptyPasswordRejected());
        addTestCase("initial credentials empty enctype list rejected", \testInitialCredentialsEmptyEnctypeListRejected());
        addTestCase("initial credentials bad keytab rejected", \testInitialCredentialsBadKeytabRejected());
        addTestCase("initial credentials keytab sandbox deny", \testInitialCredentialsKeytabSandboxDeny());
        addTestCase("initial credentials FAST cache sandbox deny", \testInitialCredentialsFastCacheSandboxDeny());
        addTestCase("gss target setup", \testGssTargetSetup());
        addTestCase("gss context options", \testGssContextOptions());
        addTestCase("gss context channel binding options", \testGssContextChannelBindingOptions());
        addTestCase("gss context invalid options", \testGssContextInvalidOptions());
        addTestCase("gss credential from keytab", \testGssCredentialFromKeytab());
        addTestCase("gss credential empty cache rejected", \testGssCredentialEmptyCacheRejected());
        addTestCase("gss credential empty keytab rejected", \testGssCredentialEmptyKeytabRejected());
        addTestCase("gss credential cache sandbox deny", \testGssCredentialCacheSandboxDeny());
        addTestCase("gss credential keytab sandbox deny", \testGssCredentialKeytabSandboxDeny());
        addTestCase("gss wrap invalid hex", \testGssWrapInvalidHex());
        addTestCase("gss unwrap invalid hex", \testGssUnwrapInvalidHex());
        addTestCase("gss wrap incomplete context", \testGssWrapIncompleteContext());
        addTestCase("gss unwrap empty token rejected", \testGssUnwrapEmptyTokenRejected());
        addTestCase("gss wrap size invalid arguments", \testGssWrapSizeInvalidArguments());
        addTestCase("gss wrap size incomplete context", \testGssWrapSizeIncompleteContext());
        addTestCase("gss invalid token hex", \testGssInvalidHex());
        addTestCase("gss empty target rejected", \testGssEmptyTarget());
        addTestCase("credential acquisition requires NETWORK domain",
            \testAcquireCredentialsRequiresNetworkDomain());
        addTestCase("keytab credential acquisition requires NETWORK domain",
            \testAcquireCredentialsWithKeytabRequiresNetworkDomain());
        addTestCase("gss client context requires NETWORK domain",
            \testGssClientContextRequiresNetworkDomain());
        addTestCase("gss credential import requires FILESYSTEM domain",
            \testGssCredentialRequiresFilesystemDomain());
        addTestCase("krb5 credentials class carries no default domain",
            \testKrb5CredentialsHasNoDomain());
        addTestCase("principal copy uses source context",
            \testPrincipalCopyAcrossContexts());
        addTestCase("memory cache store/list after explicit acquisition",
            \testStoreAndListAcrossContexts());
        addTestCase("enctype name fallback for unknown enctype",
            \testEnctypeNameFallback());
        addTestCase("credential cache store rejected under filesystem sandbox",
            \testCacheStoreSandboxDeny());

        set_return_value(main());
    }

    private string getSandboxCachePath(string suffix) {
        return sprintf("/tmp/module-krb5-%s.ccache", suffix);
    }

    private string getSandboxKeytabPath(string suffix) {
        return sprintf("/tmp/module-krb5-%s.keytab", suffix);
    }

    private cleanupSandboxCache(string path) {
        try {
            unlink(path);
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    private cleanupSandboxKeytab(string path) {
        try {
            unlink(path);
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    private string getTestKeyHex1() {
        return "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
    }

    private string getTestKeyHex2() {
        return "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100";
    }

    private testUtilityModuleHelpers() {
        assertEq("ldap/ad.example.com@EXAMPLE.COM",
            Krb5Util::getHostBasedServicePrincipal("ldap", "ad.example.com", "EXAMPLE.COM"));
    }

    private testUtilityParseHostBasedServicePrincipal() {
        hash<Krb5Util::Krb5HostBasedServicePrincipalInfo> info =
            Krb5Util::parseHostBasedServicePrincipal("HTTP/qorus.example.com@EXAMPLE.COM");
        assertEq("HTTP", info.service);
        assertEq("qorus.example.com", info.host);
        assertEq("EXAMPLE.COM", info.realm);
    }

    private testUtilityParseHostBasedServicePrincipalRejectsSingleComponent() {
        # Not a host-based service principal — only one component before the realm.
        assertThrows("KRB5-PRINCIPAL-ERROR", "host-based", sub() {
            Krb5Util::parseHostBasedServicePrincipal("alice@EXAMPLE.COM");
        });
    }

    private testUtilityParseHostBasedServicePrincipalRejectsMalformed() {
        assertThrows("KRB5-PRINCIPAL-ERROR", sub() {
            Krb5Util::parseHostBasedServicePrincipal("not-a-principal");
        });
    }

    private testUtilityBuildTlsServerEndPointChannelBindingHex() {
        # The hex-encoded ASCII prefix "tls-server-end-point:" is 21 bytes / 42 hex chars.
        string prefix_hex = "746c732d7365727665722d656e642d706f696e743a";
        string cert_hash_hex = "00112233445566778899aabbccddeeff";
        string cb = Krb5Util::buildTlsServerEndPointChannelBindingHex(cert_hash_hex);
        assertEq(prefix_hex + cert_hash_hex, cb);

        # The produced value must be acceptable as a GssClientContextOptions
        # channel_binding_application_data_hex value (accepted without error).
        hash<Qore::Krb5::GssClientContextOptions> opts();
        opts.channel_binding_application_data_hex = cb;
        Qore::Krb5::GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", ctx.getTargetName());
    }

    private testContextDefaults() {
        Qore::Krb5::Krb5Context ctx();
        string realm;
        try {
            realm = ctx.getDefaultRealm();
        } catch (hash<ExceptionInfo> ex) {
            if (ex.err == "KRB5-REALM-ERROR") {
                testSkip("no default Kerberos realm configured on this host");
            }
            rethrow;
        }
        assertFalse(realm == "");
        assertFalse(ctx.getDefaultCredentialCacheName() == "");
    }

    private testDefaultCredentialCacheMetadata() {
        Qore::Krb5::Krb5Context ctx();
        auto cc = ctx.openDefaultCredentialCache();
        assertFalse(cc.getType() == "");
        assertFalse(cc.getName() == "");
        assertFalse(cc.getFullName() == "");
    }

    private testDefaultKeytabMetadata() {
        Qore::Krb5::Krb5Context ctx();
        assertFalse(ctx.getDefaultKeytabName() == "");
        auto kt = ctx.openDefaultKeytab();
        assertFalse(kt.getType() == "");
        assertFalse(kt.getName() == "");
    }

    private Qore::Krb5::Krb5Credentials createTestCredentials(int kvno = 1) {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");
        Qore::Krb5::Krb5Credentials creds(client, server, kvno == 1 ? getTestKeyHex1() : getTestKeyHex2(),
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000, 3000, 0x40, "abcd");
        return creds;
    }

    private testCredentialsMetadata() {
        Qore::Krb5::Krb5Credentials creds = createTestCredentials();
        hash<Qore::Krb5::Krb5CredentialsInfo> info = creds.getInfo();
        assertEq("alice@EXAMPLE.COM", info.client);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", info.server);
        assertEq(Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, info.enctype);
        assertFalse(info.enctype_name == "");
        assertEq(1000, info.start_time);
        assertEq(2000, info.end_time);
        assertEq(3000, info.renew_until);
        assertEq(0x40, info.ticket_flags);
        assertEq(2, info.ticket_size);
        assertEq("alice@EXAMPLE.COM", creds.getClientPrincipal().toString());
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", creds.getServerPrincipal().toString());
    }

    private testCredentialsInvalidKeyHexRejected() {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-CREDENTIALS-ERROR", sub() {
            Qore::Krb5::Krb5Credentials bad(client, server, "xyz",
                Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000, 0, 0, "00");
        });
    }

    private testCredentialsDefaultOptionalFields() {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");
        Qore::Krb5::Krb5Credentials creds(client, server, getTestKeyHex1(),
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000);
        hash<Qore::Krb5::Krb5CredentialsInfo> info = creds.getInfo();
        assertEq(0, info.renew_until);
        assertEq(0, info.ticket_flags);
        assertEq(1, info.ticket_size);
    }

    private testCredentialsEmptyKeyRejected() {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-CREDENTIALS-ERROR", sub() {
            Qore::Krb5::Krb5Credentials bad(client, server, "",
                Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000);
        });
    }

    private testCredentialsInvalidTicketHexRejected() {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-CREDENTIALS-ERROR", sub() {
            Qore::Krb5::Krb5Credentials bad(client, server, getTestKeyHex1(),
                Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000, 0, 0, "abc");
        });
    }

    private testCredentialCacheStoreAndList() {
        Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
        Qore::Krb5::Krb5Context ctx();
        auto cc = ctx.createMemoryCredentialCache(client, "module-krb5-credential-list");
        assertEq(0, cc.listCredentials().size());

        Qore::Krb5::Krb5Credentials creds = createTestCredentials();
        cc.storeCredentials(creds);

        list<hash<Qore::Krb5::Krb5CredentialsInfo>> entries = cc.listCredentials();
        assertEq(1, entries.size());
        assertEq("alice@EXAMPLE.COM", entries[0].client);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", entries[0].server);
        assertEq(Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, entries[0].enctype);
        assertEq(2000, entries[0].end_time);
    }

    private testMemoryCredentialCacheRoundtrip() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("service/qorus.example.com@EXAMPLE.COM");
        auto cc = ctx.createMemoryCredentialCache(p, "module-krb5-roundtrip");
        assertEq("MEMORY", cc.getType());
        assertEq("module-krb5-roundtrip", cc.getName());
        assertEq("MEMORY:module-krb5-roundtrip", cc.getFullName());
        assertTrue(cc.hasPrimaryPrincipal());

        auto cp = cc.getPrimaryPrincipal();
        assertEq("service/qorus.example.com@EXAMPLE.COM", cp.toString());
        assertTrue(p.equals(cp));
    }

    private testEmptyCredentialCache() {
        Qore::Krb5::Krb5Context ctx();
        auto cc = ctx.openCredentialCache("MEMORY:module-krb5-empty");
        assertFalse(cc.hasPrimaryPrincipal());
        assertThrows("KRB5-CACHE-ERROR", sub() {
            cc.getPrimaryPrincipal();
        });
    }

    private testEmptyCacheNameRejected() {
        Qore::Krb5::Krb5Context ctx();
        assertThrows("KRB5-CACHE-ERROR", sub() {
            ctx.openCredentialCache("");
        });
        Qore::Krb5::Krb5Principal p("service/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-CACHE-ERROR", sub() {
            ctx.createMemoryCredentialCache(p, "");
        });
    }

    private testFileCacheSandboxDeny() {
        string cachePath = getSandboxCachePath("sandbox-deny");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_denied_cache() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"service/qorus.example.com@EXAMPLE.COM\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                cc.initialize(principal);
                return cc.getPrimaryPrincipal().toString();
            }
        ", cachePath), "sandbox_denied_cache");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        bool caught = False;
        try {
            p.callFunction("test_denied_cache");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err);
        }
        assertTrue(caught);
        cleanupSandboxCache(cachePath);
    }

    private testFileCacheSandboxAllow() {
        string cachePath = getSandboxCachePath("sandbox-allow");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_allowed_cache() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"service/qorus.example.com@EXAMPLE.COM\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                cc.initialize(principal);
                return cc.getPrimaryPrincipal().toString();
            }
        ", cachePath), "sandbox_allowed_cache");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/tmp");
        p.setSandboxManager(sm);

        string principal = p.callFunction("test_allowed_cache");
        assertEq("service/qorus.example.com@EXAMPLE.COM", principal);
        cleanupSandboxCache(cachePath);
    }

    private testMemoryKeytabRoundtrip() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-keytab-roundtrip");
        assertFalse(kt.hasContent());

        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 3);
        assertTrue(kt.hasContent());

        hash<Qore::Krb5::Krb5KeytabEntryInfo> entry = kt.getEntry(p);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", entry.principal);
        assertEq(3, entry.kvno);
        assertEq(Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, entry.enctype);
        assertEq(32, entry.key_size);
        assertFalse(entry.enctype_name == "");

        list<hash<Qore::Krb5::Krb5KeytabEntryInfo>> entries = kt.listEntries();
        assertEq(1, entries.size());
        assertEq(3, entries[0].kvno);
    }

    private testMemoryKeytabHighestKvno() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-keytab-highest-kvno");
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        kt.addEntry(p, getTestKeyHex2(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 5);

        hash<Qore::Krb5::Krb5KeytabEntryInfo> entry = kt.getEntry(p);
        assertEq(5, entry.kvno);
        assertEq(32, entry.key_size);
    }

    private testInvalidKeytabHexRejected() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-keytab-invalid-hex");
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-KEYTAB-ERROR", sub() {
            kt.addEntry(p, "xyz", Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        });
    }

    private testFileKeytabSandboxDeny() {
        string keytabPath = getSandboxKeytabPath("sandbox-deny");
        cleanupSandboxKeytab(keytabPath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_denied_keytab() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"HTTP/qorus.example.com@EXAMPLE.COM\");
                auto kt = ctx.openKeytab(\"FILE:%s\");
                kt.addEntry(principal,
                    \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
                return kt.getEntry(principal).principal;
            }
        ", keytabPath), "sandbox_denied_keytab");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        bool caught = False;
        try {
            p.callFunction("test_denied_keytab");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err);
        }
        assertTrue(caught);
        cleanupSandboxKeytab(keytabPath);
    }

    private testFileKeytabSandboxAllow() {
        string keytabPath = getSandboxKeytabPath("sandbox-allow");
        cleanupSandboxKeytab(keytabPath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_allowed_keytab() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"HTTP/qorus.example.com@EXAMPLE.COM\");
                auto kt = ctx.openKeytab(\"FILE:%s\");
                kt.addEntry(principal,
                    \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 2);
                return kt.getEntry(principal).principal;
            }
        ", keytabPath), "sandbox_allowed_keytab");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/tmp");
        p.setSandboxManager(sm);

        string principal = p.callFunction("test_allowed_keytab");
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", principal);
        cleanupSandboxKeytab(keytabPath);
    }

    private testPrincipalParsing() {
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", p.toString());
        assertEq("EXAMPLE.COM", p.getRealm());
        assertEq(2, p.getComponentCount());
        assertEq("HTTP", p.getComponent(0));
        assertEq("qorus.example.com", p.getComponent(1));
    }

    private testEnterprisePrincipalParsing() {
        Qore::Krb5::Krb5Principal p = Qore::Krb5::Krb5Principal::parseEnterprise(
            "alice@example.com@EXAMPLE.COM");
        assertEq("EXAMPLE.COM", p.getRealm());
        assertEq(1, p.getComponentCount());
        assertEq("alice@example.com", p.getComponent(0));
        assertEq("alice\\@example.com@EXAMPLE.COM", p.toString());
    }

    private testPrincipalCopy() {
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal p2 = p.copy();
        assertTrue(p.equals(p2));
    }

    private testPrincipalBounds() {
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-PRINCIPAL-ERROR", sub() {
            p.getComponent(2);
        });
    }

    private testInitialCredentialsEmptyPasswordRejected() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("alice@EXAMPLE.COM");
        assertThrows("KRB5-INIT-CREDS-ERROR", sub() {
            hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
            opts.canonicalize = True;
            opts.pac_request = True;
            ctx.acquireCredentialsWithPassword(p, "", opts);
        });
    }

    private testInitialCredentialsEmptyEnctypeListRejected() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("alice@EXAMPLE.COM");
        assertThrows("KRB5-INIT-CREDS-ERROR", sub() {
            hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
            opts.enctypes = ();
            ctx.acquireCredentialsWithPassword(p, "secret", opts);
        });
    }

    private testInitialCredentialsBadKeytabRejected() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("alice@EXAMPLE.COM");
        auto kt = ctx.openKeytab("MEMORY:module-krb5-empty-init-creds");
        assertThrows("KRB5-INIT-CREDS-ERROR", sub() {
            hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
            opts.canonicalize = True;
            opts.pac_request = True;
            ctx.acquireCredentialsWithKeytab(p, kt, opts);
        });
    }

    private testInitialCredentialsKeytabSandboxDeny() {
        string keytabPath = getSandboxKeytabPath("init-creds-deny");
        cleanupSandboxKeytab(keytabPath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            nothing sub test_denied_init_creds_keytab() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                auto kt = ctx.openKeytab(\"FILE:%s\");
                ctx.acquireCredentialsWithKeytab(principal, kt);
            }
        ", keytabPath), "sandbox_denied_init_creds_keytab");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        bool caught = False;
        try {
            p.callFunction("test_denied_init_creds_keytab");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err);
        }
        assertTrue(caught);
        cleanupSandboxKeytab(keytabPath);
    }

    private testInitialCredentialsFastCacheSandboxDeny() {
        string cachePath = getSandboxCachePath("fast-deny");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            nothing sub test_denied_init_creds_fast_cache() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
                opts.fast_ccache_name = \"FILE:%s\";
                opts.fast_required = True;
                opts.canonicalize = True;
                ctx.acquireCredentialsWithPassword(principal, \"secret\", opts);
            }
        ", cachePath), "sandbox_denied_init_creds_fast_cache");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        bool caught = False;
        try {
            p.callFunction("test_denied_init_creds_fast_cache");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err);
        }
        assertTrue(caught);
        cleanupSandboxCache(cachePath);
    }

    private testGssTargetSetup() {
        Qore::Krb5::GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM");
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", ctx.getTargetName());
        assertFalse(ctx.isComplete());
    }

    private testGssContextOptions() {
        hash<Qore::Krb5::GssClientContextOptions> opts();
        opts.flags = Qore::Krb5::GSS_MUTUAL_FLAG | Qore::Krb5::GSS_SEQUENCE_FLAG | Qore::Krb5::GSS_INTEG_FLAG;
        opts.lifetime = 600;
        opts.mechanism = "kerberos";

        Qore::Krb5::GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", ctx.getTargetName());
        assertFalse(ctx.isComplete());

        opts.mechanism = "default";
        Qore::Krb5::GssClientContext ctx2("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", ctx2.getTargetName());
    }

    private testGssContextChannelBindingOptions() {
        hash<Qore::Krb5::GssClientContextOptions> opts();
        opts.flags = Qore::Krb5::GSS_DEFAULT_FLAGS | Qore::Krb5::GSS_CHANNEL_BOUND_FLAG;
        opts.mechanism = "kerberos";
        opts.channel_binding_initiator_addrtype = Qore::Krb5::GSS_AF_NULLADDR;
        opts.channel_binding_acceptor_addrtype = Qore::Krb5::GSS_AF_INET;
        opts.channel_binding_acceptor_address_hex = "7f000001";
        opts.channel_binding_application_data_hex = "746c732d7365727665722d656e642d706f696e743a00112233";

        Qore::Krb5::GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", ctx.getTargetName());
        assertFalse(ctx.isComplete());
    }

    private testGssContextInvalidOptions() {
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            hash<Qore::Krb5::GssClientContextOptions> opts();
            opts.mechanism = "";
            Qore::Krb5::GssClientContext bad("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        });
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            hash<Qore::Krb5::GssClientContextOptions> opts();
            opts.mechanism = "ntlm";
            Qore::Krb5::GssClientContext bad("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        });
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            hash<Qore::Krb5::GssClientContextOptions> opts();
            opts.lifetime = -1;
            Qore::Krb5::GssClientContext bad("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        });
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            hash<Qore::Krb5::GssClientContextOptions> opts();
            opts.channel_binding_application_data_hex = "abc";
            Qore::Krb5::GssClientContext bad("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        });
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            hash<Qore::Krb5::GssClientContextOptions> opts();
            opts.channel_binding_application_data_hex = "";
            Qore::Krb5::GssClientContext bad("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        });
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            hash<Qore::Krb5::GssClientContextOptions> opts();
            opts.channel_binding_acceptor_addrtype = Qore::Krb5::GSS_AF_INET;
            Qore::Krb5::GssClientContext bad("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        });
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            hash<Qore::Krb5::GssClientContextOptions> opts();
            opts.channel_binding_acceptor_address_hex = "7f000001";
            Qore::Krb5::GssClientContext bad("HTTP/qorus.example.com@EXAMPLE.COM", opts);
        });
    }

    private testGssCredentialFromKeytab() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-gss-keytab");
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);

        auto cred = Qore::Krb5::GssCredential::fromKeytab(kt, p);
        hash<Qore::Krb5::GssClientContextOptions> opts();
        opts.mechanism = "kerberos";
        Qore::Krb5::GssClientContext gss("HTTP/qorus.example.com@EXAMPLE.COM", cred, opts);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", gss.getTargetName());
        assertFalse(gss.isComplete());
    }

    private testGssCredentialEmptyCacheRejected() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("alice@EXAMPLE.COM");
        auto cc = ctx.createMemoryCredentialCache(p, "module-krb5-empty-gss-cache");
        assertThrows("KRB5-GSS-ERROR", sub() {
            Qore::Krb5::GssCredential::fromCredentialCache(cc);
        });
    }

