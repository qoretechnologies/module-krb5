        });
    }

    private testGssCredentialCacheSandboxDeny() {
        string cachePath = getSandboxCachePath("gss-cache-deny");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            nothing sub test_denied_gss_cache() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"alice@EXAMPLE.COM\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                Qore::Krb5::GssCredential::fromCredentialCache(cc);
            }
        ", cachePath), "sandbox_denied_gss_cache");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        bool caught = False;
        try {
            p.callFunction("test_denied_gss_cache");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err);
        }
        assertTrue(caught);
        cleanupSandboxCache(cachePath);
    }

