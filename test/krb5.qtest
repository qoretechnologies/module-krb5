#!/usr/bin/env qore
%modern
%requires QUnit
%requires krb5

class Krb5ModuleTest inherits QUnit::Test {
    constructor() {
        addTestCase("context defaults", \testContextDefaults());
        addTestCase("default credential cache metadata", \testDefaultCredentialCacheMetadata());
        addTestCase("default keytab metadata", \testDefaultKeytabMetadata());
        addTestCase("memory credential cache roundtrip", \testMemoryCredentialCacheRoundtrip());
        addTestCase("empty credential cache reports no principal", \testEmptyCredentialCache());
        addTestCase("empty cache name rejected", \testEmptyCacheNameRejected());
        addTestCase("file cache sandbox deny", \testFileCacheSandboxDeny());
        addTestCase("file cache sandbox allow", \testFileCacheSandboxAllow());
        addTestCase("memory keytab roundtrip", \testMemoryKeytabRoundtrip());
        addTestCase("memory keytab highest kvno", \testMemoryKeytabHighestKvno());
        addTestCase("invalid keytab hex rejected", \testInvalidKeytabHexRejected());
        addTestCase("file keytab sandbox deny", \testFileKeytabSandboxDeny());
        addTestCase("file keytab sandbox allow", \testFileKeytabSandboxAllow());
        addTestCase("principal parsing", \testPrincipalParsing());
        addTestCase("principal copy and equality", \testPrincipalCopy());
        addTestCase("principal component bounds", \testPrincipalBounds());
        addTestCase("gss target setup", \testGssTargetSetup());
        addTestCase("gss invalid token hex", \testGssInvalidHex());
        addTestCase("gss empty target rejected", \testGssEmptyTarget());
    }

    private string getSandboxCachePath(string suffix) {
        return sprintf("/tmp/module-krb5-%s.ccache", suffix);
    }

    private string getSandboxKeytabPath(string suffix) {
        return sprintf("/tmp/module-krb5-%s.keytab", suffix);
    }

    private cleanupSandboxCache(string path) {
        try {
            unlink(path);
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    private cleanupSandboxKeytab(string path) {
        try {
            unlink(path);
        } catch (hash<ExceptionInfo> ex) {
        }
    }

    private string getTestKeyHex1() {
        return "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff";
    }

    private string getTestKeyHex2() {
        return "ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100";
    }

    private testContextDefaults() {
        Qore::Krb5::Krb5Context ctx();
        assertFalse(ctx.getDefaultRealm() == "");
        assertFalse(ctx.getDefaultCredentialCacheName() == "");
    }

    private testDefaultCredentialCacheMetadata() {
        Qore::Krb5::Krb5Context ctx();
        auto cc = ctx.openDefaultCredentialCache();
        assertFalse(cc.getType() == "");
        assertFalse(cc.getName() == "");
        assertFalse(cc.getFullName() == "");
    }

    private testDefaultKeytabMetadata() {
        Qore::Krb5::Krb5Context ctx();
        assertFalse(ctx.getDefaultKeytabName() == "");
        auto kt = ctx.openDefaultKeytab();
        assertFalse(kt.getType() == "");
        assertFalse(kt.getName() == "");
    }

    private testMemoryCredentialCacheRoundtrip() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal p("service/qorus.example.com@EXAMPLE.COM");
        auto cc = ctx.createMemoryCredentialCache(p, "module-krb5-roundtrip");
        assertEq("MEMORY", cc.getType());
        assertEq("module-krb5-roundtrip", cc.getName());
        assertEq("MEMORY:module-krb5-roundtrip", cc.getFullName());
        assertTrue(cc.hasPrimaryPrincipal());

        auto cp = cc.getPrimaryPrincipal();
        assertEq("service/qorus.example.com@EXAMPLE.COM", cp.toString());
        assertTrue(p.equals(cp));
    }

    private testEmptyCredentialCache() {
        Qore::Krb5::Krb5Context ctx();
        auto cc = ctx.openCredentialCache("MEMORY:module-krb5-empty");
        assertFalse(cc.hasPrimaryPrincipal());
        assertThrows("KRB5-CACHE-ERROR", sub() {
            cc.getPrimaryPrincipal();
        });
    }

    private testEmptyCacheNameRejected() {
        Qore::Krb5::Krb5Context ctx();
        assertThrows("KRB5-CACHE-ERROR", sub() {
            ctx.openCredentialCache("");
        });
        Qore::Krb5::Krb5Principal p("service/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-CACHE-ERROR", sub() {
            ctx.createMemoryCredentialCache(p, "");
        });
    }

    private testFileCacheSandboxDeny() {
        string cachePath = getSandboxCachePath("sandbox-deny");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_denied_cache() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"service/qorus.example.com@EXAMPLE.COM\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                cc.initialize(principal);
                return cc.getPrimaryPrincipal().toString();
            }
        ", cachePath), "sandbox_denied_cache");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        bool caught = False;
        try {
            p.callFunction("test_denied_cache");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err);
        }
        assertTrue(caught);
        cleanupSandboxCache(cachePath);
    }

    private testFileCacheSandboxAllow() {
        string cachePath = getSandboxCachePath("sandbox-allow");
        cleanupSandboxCache(cachePath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_allowed_cache() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"service/qorus.example.com@EXAMPLE.COM\");
                auto cc = ctx.openCredentialCache(\"FILE:%s\");
                cc.initialize(principal);
                return cc.getPrimaryPrincipal().toString();
            }
        ", cachePath), "sandbox_allowed_cache");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/tmp");
        p.setSandboxManager(sm);

        string principal = p.callFunction("test_allowed_cache");
        assertEq("service/qorus.example.com@EXAMPLE.COM", principal);
        cleanupSandboxCache(cachePath);
    }

    private testMemoryKeytabRoundtrip() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-keytab-roundtrip");
        assertFalse(kt.hasContent());

        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 3);
        assertTrue(kt.hasContent());

        hash<Qore::Krb5::Krb5KeytabEntryInfo> entry = kt.getEntry(p);
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", entry.principal);
        assertEq(3, entry.kvno);
        assertEq(Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, entry.enctype);
        assertEq(32, entry.key_size);
        assertFalse(entry.enctype_name == "");

        list<hash<Qore::Krb5::Krb5KeytabEntryInfo>> entries = kt.listEntries();
        assertEq(1, entries.size());
        assertEq(3, entries[0].kvno);
    }

    private testMemoryKeytabHighestKvno() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-keytab-highest-kvno");
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        kt.addEntry(p, getTestKeyHex1(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        kt.addEntry(p, getTestKeyHex2(), Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 5);

        hash<Qore::Krb5::Krb5KeytabEntryInfo> entry = kt.getEntry(p);
        assertEq(5, entry.kvno);
        assertEq(32, entry.key_size);
    }

    private testInvalidKeytabHexRejected() {
        Qore::Krb5::Krb5Context ctx();
        auto kt = ctx.openKeytab("MEMORY:module-krb5-keytab-invalid-hex");
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-KEYTAB-ERROR", sub() {
            kt.addEntry(p, "xyz", Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        });
    }

    private testFileKeytabSandboxDeny() {
        string keytabPath = getSandboxKeytabPath("sandbox-deny");
        cleanupSandboxKeytab(keytabPath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_denied_keytab() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"HTTP/qorus.example.com@EXAMPLE.COM\");
                auto kt = ctx.openKeytab(\"FILE:%s\");
                kt.addEntry(principal,
                    \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
                return kt.getEntry(principal).principal;
            }
        ", keytabPath), "sandbox_denied_keytab");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/var");
        p.setSandboxManager(sm);

        bool caught = False;
        try {
            p.callFunction("test_denied_keytab");
        } catch (hash<ExceptionInfo> ex) {
            caught = True;
            assertEq("FILESYSTEM-ACCESS-DENIED", ex.err);
        }
        assertTrue(caught);
        cleanupSandboxKeytab(keytabPath);
    }

    private testFileKeytabSandboxAllow() {
        string keytabPath = getSandboxKeytabPath("sandbox-allow");
        cleanupSandboxKeytab(keytabPath);

        Program p(PO_MODERN);
        p.loadModule("krb5");
        p.parse(sprintf("
            string sub test_allowed_keytab() {
                Qore::Krb5::Krb5Context ctx();
                Qore::Krb5::Krb5Principal principal(\"HTTP/qorus.example.com@EXAMPLE.COM\");
                auto kt = ctx.openKeytab(\"FILE:%s\");
                kt.addEntry(principal,
                    \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
                    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 2);
                return kt.getEntry(principal).principal;
            }
        ", keytabPath), "sandbox_allowed_keytab");

        SandboxManager sm();
        sm.setFilesystemSandboxRoot("/tmp");
        p.setSandboxManager(sm);

        string principal = p.callFunction("test_allowed_keytab");
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", principal);
        cleanupSandboxKeytab(keytabPath);
    }

    private testPrincipalParsing() {
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", p.toString());
        assertEq("EXAMPLE.COM", p.getRealm());
        assertEq(2, p.getComponentCount());
        assertEq("HTTP", p.getComponent(0));
        assertEq("qorus.example.com", p.getComponent(1));
    }

    private testPrincipalCopy() {
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        Qore::Krb5::Krb5Principal p2 = p.copy();
        assertTrue(p.equals(p2));
    }

    private testPrincipalBounds() {
        Qore::Krb5::Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-PRINCIPAL-ERROR", sub() {
            p.getComponent(2);
        });
    }

    private testGssTargetSetup() {
        Qore::Krb5::GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM");
        assertEq("HTTP/qorus.example.com@EXAMPLE.COM", ctx.getTargetName());
        assertFalse(ctx.isComplete());
    }

    private testGssInvalidHex() {
        Qore::Krb5::GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM");
        assertThrows("KRB5-TOKEN-ERROR", sub() {
            ctx.step("xyz");
        });
    }

    private testGssEmptyTarget() {
        assertThrows("KRB5-GSS-ARG-ERROR", sub() {
            Qore::Krb5::GssClientContext bad("");
        });
    }
}
