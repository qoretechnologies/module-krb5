/** @page krb5examples Examples

    @section krb5examples_util Utility Module

    @code{.qore}
%modern
%requires Krb5Util

string service = Krb5Util::getHostBasedServicePrincipal(
    "ldap", "ad.example.com", "EXAMPLE.COM");
    @endcode

    @section krb5examples_principal Principal Parsing

    @code{.qore}
%modern
%requires krb5

Krb5Principal p("HTTP/qorus.example.com@EXAMPLE.COM");
printf("%s\n", p.toString());
printf("%s\n", p.getRealm());

Krb5Principal upn = Krb5Principal::parseEnterprise("alice@example.com@EXAMPLE.COM");
printf("enterprise component: %s\n", upn.getComponent(0));
    @endcode

    @section krb5examples_gss GSSAPI Initiator Context

    @code{.qore}
%modern
%requires krb5

hash<Qore::Krb5::GssClientContextOptions> opts();
opts.flags = Qore::Krb5::GSS_DEFAULT_FLAGS | Qore::Krb5::GSS_CONF_FLAG;
opts.mechanism = "kerberos";

GssClientContext ctx("HTTP/qorus.example.com@EXAMPLE.COM", opts);
hash<auto> step = ctx.step();
printf("complete: %y token: %y\n", step.complete, step.token);
    @endcode

    @section krb5examples_gss_explicit_credential GSSAPI with an Explicit Credential

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Context ctx();
Qore::Krb5::Krb5Principal service("HTTP/qorus.example.com@EXAMPLE.COM");
Qore::Krb5::Krb5Keytab kt = ctx.openKeytab("FILE:/etc/qorus/qorus.keytab");
Qore::Krb5::GssCredential cred = Qore::Krb5::GssCredential::fromKeytab(kt, service);

hash<Qore::Krb5::GssClientContextOptions> opts();
opts.flags = Qore::Krb5::GSS_DEFAULT_FLAGS | Qore::Krb5::GSS_CONF_FLAG;
opts.mechanism = "kerberos";
// Example channel-binding application data; for LDAP/TLS this should be the
// RFC 5929 tls-server-end-point binding data encoded as hexadecimal.
opts.channel_binding_application_data_hex = "746c732d7365727665722d656e642d706f696e743a00112233";

Qore::Krb5::GssClientContext gss("LDAP/ad.example.com@EXAMPLE.COM", cred, opts);
hash<auto> token = gss.step();

if (gss.isComplete()) {
    int max_plaintext = gss.getWrapSizeLimit(16384, True);
    hash<auto> wrapped = gss.wrap("68656c6c6f", True);
    hash<auto> plain = gss.unwrap(wrapped.token);
    printf("max=%d confidential=%y message=%s\n", max_plaintext, plain.confidential, plain.message);
}
    @endcode

    @section krb5examples_keytab Memory Keytab Setup

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Context ctx();
Qore::Krb5::Krb5Principal principal("HTTP/qorus.example.com@EXAMPLE.COM");
auto kt = ctx.openKeytab("MEMORY:module-krb5-example");
kt.addEntry(principal,
    "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);

for (hash<Qore::Krb5::Krb5KeytabEntryInfo> entry in kt.listEntries()) {
    printf("%s kvno=%d enctype=%s\n", entry.principal, entry.kvno, entry.enctype_name);
}
    @endcode

    @section krb5examples_credentials Credential Cache Metadata

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");

Qore::Krb5::Krb5Credentials creds(client, server,
    "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000, 3000, 0, "abcd");

Qore::Krb5::Krb5Context ctx();
auto cc = ctx.createMemoryCredentialCache(client, "module-krb5-example-cache");
cc.storeCredentials(creds);

for (hash<Qore::Krb5::Krb5CredentialsInfo> info in cc.listCredentials()) {
    printf("%s -> %s until %d\n", info.client, info.server, info.end_time);
}
    @endcode

    @section krb5examples_initial_creds Initial Credentials for Active Directory

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Context ctx();
Qore::Krb5::Krb5Principal user = Qore::Krb5::Krb5Principal::parseEnterprise(
    "alice@example.com@EXAMPLE.COM");

hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
opts.canonicalize = True;
opts.pac_request = True;
opts.forwardable = True;
opts.enctypes = (Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96,);

Qore::Krb5::Krb5Credentials creds = ctx.acquireCredentialsWithPassword(
    user, ENV.KRB5_TEST_PASSWORD, opts);

auto cc = ctx.createMemoryCredentialCache(user, "module-krb5-ad-example");
cc.storeCredentials(creds);
    @endcode

    @section krb5examples_initial_creds_fast Initial Credentials with FAST

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Context ctx();
Qore::Krb5::Krb5Principal user = Qore::Krb5::Krb5Principal::parseEnterprise(
    "alice@example.com@EXAMPLE.COM");

hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
opts.canonicalize = True;
opts.pac_request = True;
opts.fast_ccache_name = "FILE:/run/qorus/krb5cc_armor";
opts.fast_required = True;

Qore::Krb5::Krb5Credentials creds = ctx.acquireCredentialsWithPassword(
    user, ENV.KRB5_TEST_PASSWORD, opts);
    @endcode

    @section krb5examples_initial_keytab Initial Credentials from Keytab

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Context ctx();
Qore::Krb5::Krb5Principal service("HTTP/qorus.example.com@EXAMPLE.COM");
Qore::Krb5::Krb5Keytab kt = ctx.openKeytab("FILE:/etc/qorus/qorus.keytab");

hash<Qore::Krb5::Krb5InitialCredentialsOptions> opts();
opts.canonicalize = True;
opts.pac_request = True;

Qore::Krb5::Krb5Credentials creds = ctx.acquireCredentialsWithKeytab(service, kt, opts);
    @endcode

    @section krb5examples_sandbox Sandbox-Protected File Credential Cache

    @code{.qore}
%modern
%requires krb5

Program p(PO_MODERN);
p.loadModule("krb5");
p.parse("
    string sub init_cache() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal principal(\"service/qorus.example.com@EXAMPLE.COM\");
        auto cc = ctx.openCredentialCache(\"FILE:/tmp/module-krb5-example.ccache\");
        cc.initialize(principal);
        return cc.getPrimaryPrincipal().toString();
    }
", "krb5_sandbox_example");

SandboxManager sm();
sm.setFilesystemSandboxRoot("/tmp");
p.setSandboxManager(sm);

printf("%s\n", p.callFunction("init_cache"));
    @endcode

    @section krb5examples_keytab_sandbox Sandbox-Protected File Keytab

    @code{.qore}
%modern
%requires krb5

Program p(PO_MODERN);
p.loadModule("krb5");
p.parse("
    string sub init_keytab() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal principal(\"HTTP/qorus.example.com@EXAMPLE.COM\");
        auto kt = ctx.openKeytab(\"FILE:/tmp/module-krb5-example.keytab\");
        kt.addEntry(principal,
            \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        return kt.getEntry(principal).principal;
    }
", "krb5_keytab_sandbox_example");

SandboxManager sm();
sm.setFilesystemSandboxRoot("/tmp");
p.setSandboxManager(sm);

printf("%s\n", p.callFunction("init_keytab"));
    @endcode
*/
