    @section krb5examples_keytab Memory Keytab Setup

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Context ctx();
Qore::Krb5::Krb5Principal principal("HTTP/qorus.example.com@EXAMPLE.COM");
auto kt = ctx.openKeytab("MEMORY:module-krb5-example");
kt.addEntry(principal,
    "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);

for (hash<Qore::Krb5::Krb5KeytabEntryInfo> entry in kt.listEntries()) {
    printf("%s kvno=%d enctype=%s\n", entry.principal, entry.kvno, entry.enctype_name);
}
    @endcode

    @section krb5examples_credentials Credential Cache Metadata

    @code{.qore}
%modern
%requires krb5

Qore::Krb5::Krb5Principal client("alice@EXAMPLE.COM");
Qore::Krb5::Krb5Principal server("HTTP/qorus.example.com@EXAMPLE.COM");

Qore::Krb5::Krb5Credentials creds(client, server,
    "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
    Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1000, 2000, 3000, 0, "abcd");

Qore::Krb5::Krb5Context ctx();
auto cc = ctx.createMemoryCredentialCache(client, "module-krb5-example-cache");
cc.storeCredentials(creds);

for (hash<Qore::Krb5::Krb5CredentialsInfo> info in cc.listCredentials()) {
    printf("%s -> %s until %d\n", info.client, info.server, info.end_time);
}
    @endcode

    @section krb5examples_sandbox Sandbox-Protected File Credential Cache

    @code{.qore}
%modern
%requires krb5

Program p(PO_MODERN);
p.loadModule("krb5");
p.parse("
    string sub init_cache() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal principal(\"service/qorus.example.com@EXAMPLE.COM\");
        auto cc = ctx.openCredentialCache(\"FILE:/tmp/module-krb5-example.ccache\");
        cc.initialize(principal);
        return cc.getPrimaryPrincipal().toString();
    }
", "krb5_sandbox_example");

SandboxManager sm();
sm.setFilesystemSandboxRoot("/tmp");
p.setSandboxManager(sm);

printf("%s\n", p.callFunction("init_cache"));
    @endcode

    @section krb5examples_keytab_sandbox Sandbox-Protected File Keytab

    @code{.qore}
%modern
%requires krb5

Program p(PO_MODERN);
p.loadModule("krb5");
p.parse("
    string sub init_keytab() {
        Qore::Krb5::Krb5Context ctx();
        Qore::Krb5::Krb5Principal principal(\"HTTP/qorus.example.com@EXAMPLE.COM\");
        auto kt = ctx.openKeytab(\"FILE:/tmp/module-krb5-example.keytab\");
        kt.addEntry(principal,
            \"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff\",
            Qore::Krb5::ENCTYPE_AES256_CTS_HMAC_SHA1_96, 1);
        return kt.getEntry(principal).principal;
    }
", "krb5_keytab_sandbox_example");

SandboxManager sm();
sm.setFilesystemSandboxRoot("/tmp");
p.setSandboxManager(sm);

printf("%s\n", p.callFunction("init_keytab"));
    @endcode
