%modern

module Krb5Util {
    version = "1.0.0";
    desc = "Kerberos 5 and GSSAPI utility module";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

%requires krb5
%requires Logger

/** @mainpage Krb5Util Module

    @tableofcontents

    @section krb5utilintro Krb5Util Module Introduction

    The \c Krb5Util module provides small %Qore-language helpers on top of
    the binary \c krb5 module:

    - @ref Krb5Util::getHostBasedServicePrincipal() builds a host-based
      Kerberos 5 service principal string
    - @ref Krb5Util::parseHostBasedServicePrincipal() splits a host-based
      service principal into its components
    - @ref Krb5Util::buildTlsServerEndPointChannelBindingHex() builds the
      <a href="https://datatracker.ietf.org/doc/html/rfc5929">RFC 5929</a>
      \c tls-server-end-point GSSAPI channel-binding application data from
      a TLS server certificate hash, ready to pass to
      @ref Qore::Krb5::GssClientContextOptions::channel_binding_application_data_hex
    - @ref Krb5Util::buildNegotiateAuthorizationHeader() and
      @ref Krb5Util::buildNegotiateWwwAuthenticateHeader() build HTTP
      Negotiate header values for SPNEGO token exchanges
    - @ref Krb5Util::parseNegotiateResponseHeader() parses SPNEGO
      NegTokenResp data including \c negState and optional response tokens
    - @ref Krb5Util::getCredentialLifecycleInfo() evaluates credential
      validity, expiry, and renewal windows from credential metadata

    Binary classes and constants remain in the \c Qore::Krb5 namespace;
    helper functions are exported from the \c Krb5Util namespace.
    Helper functions that perform SPNEGO header work accept an optional
    \c Qore::Logger::LoggerInterface object for safe diagnostics. Raw GSS
    tokens and credential material are never logged.

    @section krb5utilexample Example

    @code{.py}
%requires Krb5Util

# "ldap/ad.example.com@EXAMPLE.COM"
string service = Krb5Util::getHostBasedServicePrincipal(
    "ldap", "ad.example.com", "EXAMPLE.COM");

hash<Krb5Util::Krb5HostBasedServicePrincipalInfo> parts =
    Krb5Util::parseHostBasedServicePrincipal(service);
# parts.service == "ldap"
# parts.host    == "ad.example.com"
# parts.realm   == "EXAMPLE.COM"
    @endcode
*/

#! The public \c Krb5Util namespace
public namespace Krb5Util {
    #! Parsed components of a host-based Kerberos service principal
    public hashdecl Krb5HostBasedServicePrincipalInfo {
        #! The service component, for example \c "HTTP" or \c "ldap"
        string service;

        #! The host component, for example \c "qorus.example.com"
        string host;

        #! The realm component, for example \c "EXAMPLE.COM"
        string realm;
    }

    #! Parsed data from an SPNEGO NegTokenResp token
    public hashdecl SpnegoResponseInfo {
        #! The response token as hex, if a responseToken field is present
        *string token;

        #! The numeric negState value, if present
        *int neg_state;

        #! The symbolic negState name, if recognized
        *string neg_state_name;

        #! The supported mechanism OID DER value as hex, if present
        *string supported_mech_oid_hex;

        #! The mechListMIC value as hex, if present
        *string mech_list_mic;
    }

    #! Credential validity and renewal status computed from credential metadata
    public hashdecl CredentialLifecycleInfo {
        #! Evaluation time as seconds since the Unix epoch
        int now_epoch_seconds;

        #! Credential start time as seconds since the Unix epoch
        int start_time;

        #! Credential end time as seconds since the Unix epoch
        int end_time;

        #! Credential renew-until time as seconds since the Unix epoch, or 0 if not renewable
        int renew_until;

        #! Seconds from the evaluation time until the credential starts; negative when already started
        int seconds_until_start;

        #! Seconds from the evaluation time until credential expiry; negative when expired
        int remaining_seconds;

        #! Seconds from the evaluation time until the renewable lifetime ends; 0 when not renewable
        int renewable_seconds;

        #! True when the evaluation time is at or after the credential start time
        bool started;

        #! True when the evaluation time is at or after the credential end time
        bool expired;

        #! True when the credential has started and is not expired
        bool valid;

        #! True when the credential has a renewable lifetime that has not elapsed
        bool renewable;

        #! True when a valid credential is within the configured renewal threshold
        bool within_renewal_threshold;

        #! True when the credential is valid, renewable, and within the renewal threshold
        bool should_renew;
    }

    #! Builds a host-based Kerberos 5 service principal string of the form \c "service/host@REALM"
    /** @par Example:
        @code{.py}
string sp = Krb5Util::getHostBasedServicePrincipal(
    "ldap", "ad.example.com", "EXAMPLE.COM");
# -> "ldap/ad.example.com@EXAMPLE.COM"
        @endcode

        @param service the service component, such as \c "HTTP", \c "ldap",
        or \c "host"
        @param host the fully-qualified DNS name of the host running the
        service
        @param realm the Kerberos realm

        @return a host-based service principal string in the form
        \c "service/host@REALM"
    */
    public string sub getHostBasedServicePrincipal(string service, string host, string realm) {
        return sprintf("%s/%s@%s", service, host, realm);
    }

    #! Splits a host-based Kerberos 5 service principal of the form \c "service/host@REALM" into its components
    /** @par Example:
        @code{.py}
hash<Krb5Util::Krb5HostBasedServicePrincipalInfo> info =
    Krb5Util::parseHostBasedServicePrincipal("HTTP/qorus.example.com@EXAMPLE.COM");
# info.service == "HTTP"
# info.host    == "qorus.example.com"
# info.realm   == "EXAMPLE.COM"
        @endcode

        @param principal_string a host-based service principal string

        @return a @ref Krb5HostBasedServicePrincipalInfo hash with the
        parsed \c service, \c host, and \c realm components

        @throw KRB5-PRINCIPAL-ERROR if \a principal_string cannot be parsed
        or is not a host-based service principal
    */
    public hash<Krb5HostBasedServicePrincipalInfo> sub parseHostBasedServicePrincipal(string principal_string) {
        Qore::Krb5::Krb5Principal p(principal_string);
        if (p.getComponentCount() != 2) {
            throw "KRB5-PRINCIPAL-ERROR",
                sprintf("principal %y is not a host-based service principal "
                    "(expected 2 components, got %d)", principal_string, p.getComponentCount());
        }
        return <Krb5HostBasedServicePrincipalInfo>{
            "service": p.getComponent(0),
            "host": p.getComponent(1),
            "realm": p.getRealm(),
        };
    }

    #! Builds the RFC 5929 \c tls-server-end-point GSSAPI channel-binding application data as a hex-encoded string
    /** The returned string is ready to assign to
        @ref Qore::Krb5::GssClientContextOptions::channel_binding_application_data_hex.
        Per
        <a href="https://datatracker.ietf.org/doc/html/rfc5929#section-4">RFC
        5929 §4</a>, the value is the ASCII constant
        \c "tls-server-end-point:" followed by the hash of the server
        certificate computed with the hash algorithm used in the certificate
        signature (or SHA-256 when the signature uses MD5 or SHA-1), both
        concatenated as a byte string. This function takes that hash as a
        hex string and returns the full hex-encoded binding data.

        @par Example:
        @code{.py}
# server_cert_hash_hex is the hex of the TLS server certificate hash
# computed per RFC 5929 §4.1.
string cb = Krb5Util::buildTlsServerEndPointChannelBindingHex(server_cert_hash_hex);

hash<Qore::Krb5::GssClientContextOptions> opts();
opts.channel_binding_application_data_hex = cb;
Qore::Krb5::GssClientContext ctx("LDAP/ad.example.com@EXAMPLE.COM", opts);
        @endcode

        @param server_cert_hash_hex the TLS server certificate hash as a
        hex string, computed per
        <a href="https://datatracker.ietf.org/doc/html/rfc5929#section-4.1">RFC
        5929 §4.1</a>

        @return a hex-encoded string that is the concatenation of the ASCII
        prefix \c "tls-server-end-point:" and \a server_cert_hash_hex

        @throw KRB5-CHANNEL-BINDING-ERROR if \a server_cert_hash_hex is
        empty or is not valid hexadecimal
    */
    public string sub buildTlsServerEndPointChannelBindingHex(string server_cert_hash_hex) {
        if (!server_cert_hash_hex) {
            throw "KRB5-CHANNEL-BINDING-ERROR", "certificate hash hex cannot be empty";
        }
        if (server_cert_hash_hex.size() % 2) {
            throw "KRB5-CHANNEL-BINDING-ERROR", "certificate hash hex must have even length";
        }
        if (server_cert_hash_hex !~ /^[[:xdigit:]]+$/) {
            throw "KRB5-CHANNEL-BINDING-ERROR", "certificate hash contains non-hexadecimal characters";
        }

        # "tls-server-end-point:" in hex
        return "746c732d7365727665722d656e642d706f696e743a" + server_cert_hash_hex;
    }

    #! Evaluates credential validity and renewal status from credential metadata
    /** This helper operates on the metadata returned by
        Qore::Krb5::Krb5Credentials::getInfo() or
        Qore::Krb5::Krb5CredentialCache::listCredentials(). It does not read
        key or ticket bytes.

        @param creds credential metadata
        @param renew_threshold_seconds renewal threshold in seconds. A valid
        renewable credential is considered due for renewal when its remaining
        lifetime is less than or equal to this value
        @param now_epoch_seconds optional deterministic evaluation time as
        seconds since the Unix epoch; defaults to the current time
        @param logger optional logger for safe diagnostics; raw credential
        material is not logged

        @return credential lifecycle information

        @throw KRB5-CREDENTIAL-LIFECYCLE-ERROR if timestamps or threshold
        values are invalid
    */
    public hash<CredentialLifecycleInfo> sub getCredentialLifecycleInfo(
            hash<Qore::Krb5::Krb5CredentialsInfo> creds, int renew_threshold_seconds = 300,
            *int now_epoch_seconds = NOTHING, *Qore::Logger::LoggerInterface logger = NOTHING) {
        validateCredentialLifecycleInputs(creds, renew_threshold_seconds, now_epoch_seconds);

        int evalTime = exists now_epoch_seconds ? now_epoch_seconds : now().getEpochSeconds();
        int remaining = creds.end_time - evalTime;
        int renewableRemaining = creds.renew_until ? creds.renew_until - evalTime : 0;
        bool started = evalTime >= creds.start_time;
        bool expired = evalTime >= creds.end_time;
        bool renewable = creds.renew_until > 0 && evalTime < creds.renew_until;
        bool withinRenewalThreshold = started && !expired && remaining <= renew_threshold_seconds;
        bool shouldRenew = withinRenewalThreshold && renewable;

        hash<CredentialLifecycleInfo> rv = <CredentialLifecycleInfo>{
            "now_epoch_seconds": evalTime,
            "start_time": creds.start_time,
            "end_time": creds.end_time,
            "renew_until": creds.renew_until,
            "seconds_until_start": creds.start_time - evalTime,
            "remaining_seconds": remaining,
            "renewable_seconds": renewableRemaining,
            "started": started,
            "expired": expired,
            "valid": started && !expired,
            "renewable": renewable,
            "within_renewal_threshold": withinRenewalThreshold,
            "should_renew": shouldRenew,
        };

        logCredentialLifecycle(logger, sprintf("client=%y server=%y remaining_seconds=%d renewable_seconds=%d "
            "valid=%y expired=%y should_renew=%y", creds.client, creds.server, rv.remaining_seconds,
            rv.renewable_seconds, rv.valid, rv.expired, rv.should_renew));
        return rv;
    }

    #! Returns True if credential metadata is expired at the evaluation time
    /** @param creds credential metadata
        @param now_epoch_seconds optional deterministic evaluation time as
        seconds since the Unix epoch; defaults to the current time
        @param logger optional logger for safe diagnostics

        @return True if the credential is expired

        @throw KRB5-CREDENTIAL-LIFECYCLE-ERROR if timestamps are invalid
    */
    public bool sub isCredentialExpired(hash<Qore::Krb5::Krb5CredentialsInfo> creds,
            *int now_epoch_seconds = NOTHING, *Qore::Logger::LoggerInterface logger = NOTHING) {
        return getCredentialLifecycleInfo(creds, 0, now_epoch_seconds, logger).expired;
    }

    #! Returns True if credential metadata is valid, renewable, and within the renewal threshold
    /** @param creds credential metadata
        @param renew_threshold_seconds renewal threshold in seconds
        @param now_epoch_seconds optional deterministic evaluation time as
        seconds since the Unix epoch; defaults to the current time
        @param logger optional logger for safe diagnostics

        @return True if the credential should be renewed now

        @throw KRB5-CREDENTIAL-LIFECYCLE-ERROR if timestamps or threshold
        values are invalid
    */
    public bool sub shouldRenewCredential(hash<Qore::Krb5::Krb5CredentialsInfo> creds,
            int renew_threshold_seconds = 300, *int now_epoch_seconds = NOTHING,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        return getCredentialLifecycleInfo(creds, renew_threshold_seconds, now_epoch_seconds, logger).should_renew;
    }

    #! Encodes an ASN.1 DER length
    binary sub derLength(int len) {
        if (len < 0x80) {
            return binary(chr(len));
        }
        if (len <= 0xff) {
            return <81> + binary(chr(len));
        }
        if (len <= 0xffff) {
            return <82> + binary(chr(len >> 8)) + binary(chr(len & 0xff));
        }
        return <83> + binary(chr(len >> 16)) + binary(chr((len >> 8) & 0xff)) + binary(chr(len & 0xff));
    }

    #! Wraps data in an ASN.1 DER TLV (tag-length-value)
    binary sub derWrap(int tag, binary value) {
        return binary(chr(tag)) + derLength(value.size()) + value;
    }

    #! Wraps a hex-encoded GSSAPI token in an RFC 4178 SPNEGO NegTokenInit envelope and returns it as base64
    /** This builds an SPNEGO initial context token (RFC 2743 Section 3.1 /
        RFC 4178 Section 4.2.1) containing the Kerberos 5 mechanism OID
        and the provided GSS token as the mechToken field. The result is
        base64-encoded, ready for use in an HTTP
        \c "Authorization: Negotiate <base64>" header.

        @par Example:
        @code{.py}
%requires Krb5Util
%requires krb5

Qore::Krb5::GssClientContext initiator("HTTP/web.example.com@EXAMPLE.COM");
hash<Qore::Krb5::GssStepInfo> step = initiator.step();
string authHeader = "Negotiate " + Krb5Util::negotiateSpnegoToken(step.token);
        @endcode

        @param gss_token_hex hex-encoded GSSAPI token from GssClientContext::step()
        @param logger optional logger for safe diagnostics; only sizes and
        operation names are logged

        @return base64-encoded SPNEGO NegTokenInit envelope

        @throw KRB5-SPNEGO-ERROR if the input token is empty or invalid hex
    */
    public string sub negotiateSpnegoToken(string gss_token_hex,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        if (!gss_token_hex.val()) {
            throw "KRB5-SPNEGO-ERROR", "GSS token cannot be empty";
        }
        if (gss_token_hex.size() % 2) {
            throw "KRB5-SPNEGO-ERROR", "GSS token hex must have even length";
        }
        if (gss_token_hex !~ /^[[:xdigit:]]+$/) {
            throw "KRB5-SPNEGO-ERROR", "GSS token contains non-hexadecimal characters";
        }

        binary mechToken = parse_hex_string(gss_token_hex);

        # SPNEGO OID 1.3.6.1.5.5.2 in DER: 06 06 2b 06 01 05 05 02
        binary spnegoOid = parse_hex_string("06062b0601050502");
        # Kerberos 5 OID 1.2.840.113554.1.2.2 in DER: 06 09 2a 86 48 86 f7 12 01 02 02
        binary krb5Oid = parse_hex_string("06092a864886f712010202");

        # Build NegTokenInit SEQUENCE:
        #   [0] SEQUENCE { OID krb5 }        -- mechTypes
        #   [2] OCTET STRING { mechToken }   -- mechToken
        binary mechTypes = derWrap(0xa0, derWrap(0x30, krb5Oid));
        binary mechTokenField = derWrap(0xa2, derWrap(0x04, mechToken));
        binary negTokenInit = derWrap(0x30, mechTypes + mechTokenField);

        # Wrap in context [0] for NegotiationToken choice
        binary negToken = derWrap(0xa0, negTokenInit);

        # Build RFC 2743 Section 3.1 initial context token:
        #   APPLICATION[0] { OID spnego, NegotiationToken }
        binary innerToken = spnegoOid + negToken;
        binary applicationToken = derWrap(0x60, innerToken);

        logSpnego(logger, sprintf("built NegTokenInit token_bytes=%d spnego_bytes=%d",
            mechToken.size(), applicationToken.size()));
        return make_base64_string(applicationToken);
    }

    #! Builds an HTTP \c Authorization header with an SPNEGO NegTokenInit token
    /** The returned string has the form \c "Negotiate <base64-token>" and
        is ready to use as an HTTP \c Authorization header value.

        @param gss_token_hex hex-encoded GSSAPI token from GssClientContext::step()
        @param logger optional logger for safe diagnostics; raw token data is
        not logged

        @return HTTP Negotiate authorization header value

        @throw KRB5-SPNEGO-ERROR if the input token is empty or invalid hex
    */
    public string sub buildNegotiateAuthorizationHeader(string gss_token_hex,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        string token = negotiateSpnegoToken(gss_token_hex, logger);
        logSpnego(logger, sprintf("built Authorization Negotiate header token_b64_bytes=%d", token.size()));
        return "Negotiate " + token;
    }

    #! Builds a base64-encoded SPNEGO NegTokenResp token
    /** Builds an RFC 4178 \c NegTokenResp token for HTTP Negotiate
        server-side responses. A response can contain a GSS response token,
        a \c negState value, or both.

        @param gss_token_hex optional hex-encoded GSSAPI response token
        @param neg_state optional RFC 4178 \c negState value:
        0 = \c accept-completed, 1 = \c accept-incomplete, 2 = \c reject,
        3 = \c request-mic
        @param logger optional logger for safe diagnostics; raw token data is
        not logged

        @return base64-encoded SPNEGO NegTokenResp token

        @throw KRB5-SPNEGO-ERROR if neither \a gss_token_hex nor
        \a neg_state is provided, if \a neg_state is outside 0..3, or if the
        GSS token is empty or invalid hex
    */
    public string sub negotiateSpnegoResponseToken(*string gss_token_hex = NOTHING, *int neg_state = NOTHING,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        bool hasToken = exists gss_token_hex;
        bool hasState = exists neg_state;
        if (!hasToken && !hasState) {
            throw "KRB5-SPNEGO-ERROR", "NegTokenResp requires a response token or negState";
        }

        binary content;
        if (hasState) {
            if (neg_state < 0 || neg_state > 3) {
                throw "KRB5-SPNEGO-ERROR", "negState must be between 0 and 3";
            }
            content += derWrap(0xa0, derWrap(0x0a, binary(chr(neg_state))));
        }

        int tokenBytes = 0;
        if (hasToken) {
            if (!gss_token_hex.val()) {
                throw "KRB5-SPNEGO-ERROR", "GSS token cannot be empty";
            }
            if (gss_token_hex.size() % 2) {
                throw "KRB5-SPNEGO-ERROR", "GSS token hex must have even length";
            }
            if (gss_token_hex !~ /^[[:xdigit:]]+$/) {
                throw "KRB5-SPNEGO-ERROR", "GSS token contains non-hexadecimal characters";
            }
            binary token = parse_hex_string(gss_token_hex);
            tokenBytes = token.size();
            content += derWrap(0xa2, derWrap(0x04, token));
        }

        binary response = derWrap(0xa1, derWrap(0x30, content));
        logSpnego(logger, sprintf("built NegTokenResp token_bytes=%d spnego_bytes=%d neg_state=%y",
            tokenBytes, response.size(), hasState ? neg_state : NOTHING));
        return make_base64_string(response);
    }

    #! Builds an HTTP \c WWW-Authenticate header with an optional SPNEGO NegTokenResp token
    /** With no arguments this returns \c "Negotiate", which is the initial
        HTTP challenge. With a token or \c negState it returns
        \c "Negotiate <base64-token>".

        @param gss_token_hex optional hex-encoded GSSAPI response token
        @param neg_state optional RFC 4178 \c negState value
        @param logger optional logger for safe diagnostics; raw token data is
        not logged

        @return HTTP Negotiate \c WWW-Authenticate header value

        @throw KRB5-SPNEGO-ERROR if supplied token or \c negState values are invalid
    */
    public string sub buildNegotiateWwwAuthenticateHeader(*string gss_token_hex = NOTHING,
            *int neg_state = NOTHING, *Qore::Logger::LoggerInterface logger = NOTHING) {
        if (!exists gss_token_hex && !exists neg_state) {
            logSpnego(logger, "built empty WWW-Authenticate Negotiate challenge");
            return "Negotiate";
        }

        string token = negotiateSpnegoResponseToken(gss_token_hex, neg_state, logger);
        logSpnego(logger, sprintf("built WWW-Authenticate Negotiate header token_b64_bytes=%d", token.size()));
        return "Negotiate " + token;
    }

    #! Extracts the base64 token from an HTTP Negotiate header value
    /** Accepts either a bare \c "Negotiate <base64-token>" value or a full
        header line such as \c "Authorization: Negotiate <base64-token>".

        @param header HTTP Negotiate header value or full header line
        @param logger optional logger for safe diagnostics; raw token data is
        not logged

        @return base64 token string

        @throw KRB5-SPNEGO-ERROR if \a header is not a Negotiate value, does
        not contain a token, or contains invalid base64 data
    */
    public string sub extractNegotiateHeaderToken(string header,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        string value = trim(header);
        int colon = value.find(":");
        if (colon >= 0) {
            value = trim(value.substr(colon + 1));
        }

        if (value !~ /^Negotiate([[:space:]]|$)/i) {
            throw "KRB5-SPNEGO-ERROR", "HTTP header does not use the Negotiate authentication scheme";
        }

        string token = trim(value.substr(9));
        if (!token.val()) {
            throw "KRB5-SPNEGO-ERROR", "Negotiate header does not contain a token";
        }

        try {
            parse_base64_string(token);
        } catch (hash<ExceptionInfo> ex) {
            throw "KRB5-SPNEGO-ERROR", sprintf("invalid Negotiate token base64: %s", ex.desc);
        }

        logSpnego(logger, sprintf("extracted Negotiate header token_b64_bytes=%d", token.size()));
        return token;
    }

    #! Parses a base64-encoded SPNEGO NegTokenResp and extracts the contained GSS response token as hex
    /** @par Example:
        @code{.py}
string gssHex = Krb5Util::parseSpnegoResponse(base64ResponseFromServer);
hash<Qore::Krb5::GssStepInfo> step = initiator.step(gssHex);
        @endcode

        @param base64_token base64-encoded SPNEGO response from HTTP
        \c "WWW-Authenticate: Negotiate <base64>"
        @param logger optional logger for safe diagnostics; raw token data is
        not logged

        @return hex-encoded GSS token extracted from the responseToken field

        @throw KRB5-SPNEGO-ERROR if the token cannot be parsed or does not
        contain a responseToken
    */
    public string sub parseSpnegoResponse(string base64_token,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        hash<SpnegoResponseInfo> info = parseSpnegoResponseInfo(base64_token, logger);
        if (!exists info.token) {
            throw "KRB5-SPNEGO-ERROR", "SPNEGO response does not contain a responseToken field";
        }
        return info.token;
    }

    #! Parses a base64-encoded SPNEGO NegTokenResp and returns structured response information
    /** This is useful for server responses that carry \c negState without a
        response token, such as \c accept-completed.

        @param base64_token base64-encoded SPNEGO NegTokenResp token
        @param logger optional logger for safe diagnostics; raw token data is
        not logged

        @return parsed SPNEGO response information

        @throw KRB5-SPNEGO-ERROR if the token is empty, invalid base64, or
        not a supported DER-encoded SPNEGO NegTokenResp
    */
    public hash<SpnegoResponseInfo> sub parseSpnegoResponseInfo(string base64_token,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        if (!base64_token.val()) {
            throw "KRB5-SPNEGO-ERROR", "SPNEGO response cannot be empty";
        }

        binary data;
        try {
            data = parse_base64_string(base64_token);
        } catch (hash<ExceptionInfo> ex) {
            throw "KRB5-SPNEGO-ERROR", sprintf("invalid base64: %s", ex.desc);
        }

        if (data.size() < 2) {
            throw "KRB5-SPNEGO-ERROR", "SPNEGO response too short";
        }

        # Expect NegotiationToken ::= CHOICE { negTokenResp [1] NegTokenResp }
        # NegTokenResp ::= SEQUENCE { ... [2] OCTET STRING responseToken ... }
        # We walk the DER structure to find the [2] context tag containing the token

        # The outer wrapper should be context [1] (NegTokenResp choice)
        int pos = 0;
        if (data[pos] != 0xa1) {
            throw "KRB5-SPNEGO-ERROR", sprintf("expected NegTokenResp (tag 0xa1), got 0x%02x",
                data[pos]);
        }
        ++pos;
        int seqLen;
        (seqLen, pos) = parseDerLength(data, pos);
        checkDerBounds(data, pos, seqLen, "NegTokenResp");
        int outerEnd = pos + seqLen;

        # Inside is a SEQUENCE
        if (pos >= outerEnd || data[pos] != 0x30) {
            throw "KRB5-SPNEGO-ERROR", sprintf("expected SEQUENCE (tag 0x30), got 0x%02x",
                pos < data.size() ? data[pos] : -1);
        }
        ++pos;
        int innerLen;
        (innerLen, pos) = parseDerLength(data, pos);
        checkDerBounds(data, pos, innerLen, "NegTokenResp SEQUENCE");
        int endPos = pos + innerLen;
        if (endPos != outerEnd) {
            throw "KRB5-SPNEGO-ERROR", "NegTokenResp SEQUENCE length does not match outer length";
        }

        hash<SpnegoResponseInfo> rv();
        # Walk the SEQUENCE fields looking for known NegTokenResp fields
        while (pos < endPos) {
            if (pos >= data.size()) {
                throw "KRB5-SPNEGO-ERROR", "unexpected end of DER data while parsing field tag";
            }
            int tag = data[pos];
            ++pos;
            int fieldLen;
            (fieldLen, pos) = parseDerLength(data, pos);
            checkDerBounds(data, pos, fieldLen, "NegTokenResp field");
            if (pos + fieldLen > endPos) {
                throw "KRB5-SPNEGO-ERROR", "NegTokenResp field length exceeds SEQUENCE length";
            }

            int fieldEnd = pos + fieldLen;
            if (tag == 0xa0) {
                if (pos >= fieldEnd || data[pos] != 0x0a) {
                    throw "KRB5-SPNEGO-ERROR", "negState field does not contain ENUMERATED";
                }
                ++pos;
                int stateLen;
                (stateLen, pos) = parseDerLength(data, pos);
                checkDerBounds(data, pos, stateLen, "negState ENUMERATED");
                if (stateLen != 1 || pos + stateLen != fieldEnd) {
                    throw "KRB5-SPNEGO-ERROR", "negState ENUMERATED must be exactly one byte";
                }
                rv.neg_state = data[pos];
                rv.neg_state_name = getNegStateName(rv.neg_state);
            } else if (tag == 0xa1) {
                if (pos >= fieldEnd || data[pos] != 0x06) {
                    throw "KRB5-SPNEGO-ERROR", "supportedMech field does not contain OBJECT IDENTIFIER";
                }
                rv.supported_mech_oid_hex = make_hex_string(data.substr(pos, fieldLen));
            } else if (tag == 0xa2) {
                # Found responseToken; contains an OCTET STRING.
                if (pos >= fieldEnd || data[pos] != 0x04) {
                    throw "KRB5-SPNEGO-ERROR", "responseToken field does not contain OCTET STRING";
                }
                ++pos;
                int tokenLen;
                (tokenLen, pos) = parseDerLength(data, pos);
                checkDerBounds(data, pos, tokenLen, "responseToken OCTET STRING");
                if (pos + tokenLen != fieldEnd) {
                    throw "KRB5-SPNEGO-ERROR", "responseToken OCTET STRING length does not match field length";
                }
                binary token = data.substr(pos, tokenLen);
                rv.token = make_hex_string(token);
            } else if (tag == 0xa3) {
                if (pos >= fieldEnd || data[pos] != 0x04) {
                    throw "KRB5-SPNEGO-ERROR", "mechListMIC field does not contain OCTET STRING";
                }
                ++pos;
                int micLen;
                (micLen, pos) = parseDerLength(data, pos);
                checkDerBounds(data, pos, micLen, "mechListMIC OCTET STRING");
                if (pos + micLen != fieldEnd) {
                    throw "KRB5-SPNEGO-ERROR", "mechListMIC OCTET STRING length does not match field length";
                }
                rv.mech_list_mic = make_hex_string(data.substr(pos, micLen));
            }
            pos = fieldEnd;
        }

        logSpnego(logger, sprintf("parsed NegTokenResp token_bytes=%d neg_state=%y",
            exists rv.token ? rv.token.size() / 2 : 0, exists rv.neg_state ? rv.neg_state : NOTHING));
        return rv;
    }

    #! Parses an HTTP Negotiate response header and returns structured SPNEGO response information
    /** Accepts either a bare \c "Negotiate <base64-token>" value or a full
        \c "WWW-Authenticate: Negotiate <base64-token>" header line.

        @param header HTTP Negotiate response header value or full header line
        @param logger optional logger for safe diagnostics; raw token data is
        not logged

        @return parsed SPNEGO response information

        @throw KRB5-SPNEGO-ERROR if the header or token is invalid
    */
    public hash<SpnegoResponseInfo> sub parseNegotiateResponseHeader(string header,
            *Qore::Logger::LoggerInterface logger = NOTHING) {
        return parseSpnegoResponseInfo(extractNegotiateHeaderToken(header, logger), logger);
    }

    #! Parses a DER length field and returns (length, newPosition)
    list<int> sub parseDerLength(binary data, int pos) {
        if (pos >= data.size()) {
            throw "KRB5-SPNEGO-ERROR", "unexpected end of DER data while parsing length";
        }
        int first = data[pos];
        ++pos;
        if (first < 0x80) {
            return (first, pos);
        }
        int numBytes = first & 0x7f;
        if (numBytes == 0 || numBytes > 3) {
            throw "KRB5-SPNEGO-ERROR", sprintf("unsupported DER length encoding (%d bytes)", numBytes);
        }
        int len = 0;
        for (int i = 0; i < numBytes; i++) {
            if (pos >= data.size()) {
                throw "KRB5-SPNEGO-ERROR", "unexpected end of DER data while parsing multi-byte length";
            }
            len = (len << 8) | data[pos];
            ++pos;
        }
        return (len, pos);
    }

    #! Verifies that a DER value with the given start and length fits in the input
    sub checkDerBounds(binary data, int pos, int len, string context_name) {
        if (len < 0 || pos < 0 || pos > data.size() || len > data.size() - pos) {
            throw "KRB5-SPNEGO-ERROR", sprintf("%s length exceeds available DER data", context_name);
        }
    }

    #! Validates credential lifecycle helper inputs
    sub validateCredentialLifecycleInputs(hash<Qore::Krb5::Krb5CredentialsInfo> creds,
            int renew_threshold_seconds, *int now_epoch_seconds) {
        if (renew_threshold_seconds < 0) {
            throw "KRB5-CREDENTIAL-LIFECYCLE-ERROR", "renewal threshold cannot be negative";
        }
        if (exists now_epoch_seconds && now_epoch_seconds < 0) {
            throw "KRB5-CREDENTIAL-LIFECYCLE-ERROR", "evaluation time cannot be negative";
        }
        if (creds.start_time < 0) {
            throw "KRB5-CREDENTIAL-LIFECYCLE-ERROR", "credential start time cannot be negative";
        }
        if (creds.end_time < 0) {
            throw "KRB5-CREDENTIAL-LIFECYCLE-ERROR", "credential end time cannot be negative";
        }
        if (creds.renew_until < 0) {
            throw "KRB5-CREDENTIAL-LIFECYCLE-ERROR", "credential renew-until time cannot be negative";
        }
        if (creds.end_time < creds.start_time) {
            throw "KRB5-CREDENTIAL-LIFECYCLE-ERROR", "credential end time is before start time";
        }
    }

    #! Returns a symbolic name for an RFC 4178 negState value
    *string sub getNegStateName(int neg_state) {
        switch (neg_state) {
            case 0:
                return "accept-completed";
            case 1:
                return "accept-incomplete";
            case 2:
                return "reject";
            case 3:
                return "request-mic";
        }
    }

    #! Logs safe SPNEGO diagnostics without raw tokens or credential material
    sub logSpnego(*Qore::Logger::LoggerInterface logger, string message) {
        if (logger) {
            logger.debug("Krb5Util SPNEGO: %s", message);
        }
    }

    #! Logs safe credential lifecycle diagnostics without raw credential material
    sub logCredentialLifecycle(*Qore::Logger::LoggerInterface logger, string message) {
        if (logger) {
            logger.debug("Krb5Util credential lifecycle: %s", message);
        }
    }
}
