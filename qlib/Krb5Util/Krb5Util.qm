%modern

module Krb5Util {
    version = "1.0.0";
    desc = "Kerberos 5 and GSSAPI utility module";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

%requires krb5

/** @mainpage Krb5Util Module

    @tableofcontents

    @section krb5utilintro Krb5Util Module Introduction

    The \c Krb5Util module provides small %Qore-language helpers on top of
    the binary \c krb5 module:

    - @ref Krb5Util::getHostBasedServicePrincipal() builds a host-based
      Kerberos 5 service principal string
    - @ref Krb5Util::parseHostBasedServicePrincipal() splits a host-based
      service principal into its components
    - @ref Krb5Util::buildTlsServerEndPointChannelBindingHex() builds the
      <a href="https://datatracker.ietf.org/doc/html/rfc5929">RFC 5929</a>
      \c tls-server-end-point GSSAPI channel-binding application data from
      a TLS server certificate hash, ready to pass to
      @ref Qore::Krb5::GssClientContextOptions::channel_binding_application_data_hex

    Binary classes and constants remain in the \c Qore::Krb5 namespace;
    helper functions are exported from the \c Krb5Util namespace.

    @section krb5utilexample Example

    @code{.py}
%requires Krb5Util

# "ldap/ad.example.com@EXAMPLE.COM"
string service = Krb5Util::getHostBasedServicePrincipal(
    "ldap", "ad.example.com", "EXAMPLE.COM");

hash<Krb5Util::Krb5HostBasedServicePrincipalInfo> parts =
    Krb5Util::parseHostBasedServicePrincipal(service);
# parts.service == "ldap"
# parts.host    == "ad.example.com"
# parts.realm   == "EXAMPLE.COM"
    @endcode
*/

#! The public \c Krb5Util namespace
public namespace Krb5Util {
    #! Parsed components of a host-based Kerberos service principal
    public hashdecl Krb5HostBasedServicePrincipalInfo {
        #! The service component, for example \c "HTTP" or \c "ldap"
        string service;

        #! The host component, for example \c "qorus.example.com"
        string host;

        #! The realm component, for example \c "EXAMPLE.COM"
        string realm;
    }

    #! Builds a host-based Kerberos 5 service principal string of the form \c "service/host@REALM"
    /** @par Example:
        @code{.py}
string sp = Krb5Util::getHostBasedServicePrincipal(
    "ldap", "ad.example.com", "EXAMPLE.COM");
# -> "ldap/ad.example.com@EXAMPLE.COM"
        @endcode

        @param service the service component, such as \c "HTTP", \c "ldap",
        or \c "host"
        @param host the fully-qualified DNS name of the host running the
        service
        @param realm the Kerberos realm

        @return a host-based service principal string in the form
        \c "service/host@REALM"
    */
    public string sub getHostBasedServicePrincipal(string service, string host, string realm) {
        return sprintf("%s/%s@%s", service, host, realm);
    }

    #! Splits a host-based Kerberos 5 service principal of the form \c "service/host@REALM" into its components
    /** @par Example:
        @code{.py}
hash<Krb5Util::Krb5HostBasedServicePrincipalInfo> info =
    Krb5Util::parseHostBasedServicePrincipal("HTTP/qorus.example.com@EXAMPLE.COM");
# info.service == "HTTP"
# info.host    == "qorus.example.com"
# info.realm   == "EXAMPLE.COM"
        @endcode

        @param principal_string a host-based service principal string

        @return a @ref Krb5HostBasedServicePrincipalInfo hash with the
        parsed \c service, \c host, and \c realm components

        @throw KRB5-PRINCIPAL-ERROR if \a principal_string cannot be parsed
        or is not a host-based service principal
    */
    public hash<Krb5HostBasedServicePrincipalInfo> sub parseHostBasedServicePrincipal(string principal_string) {
        Qore::Krb5::Krb5Principal p(principal_string);
        if (p.getComponentCount() != 2) {
            throw "KRB5-PRINCIPAL-ERROR",
                sprintf("principal %y is not a host-based service principal "
                    "(expected 2 components, got %d)", principal_string, p.getComponentCount());
        }
        return <Krb5HostBasedServicePrincipalInfo>{
            "service": p.getComponent(0),
            "host": p.getComponent(1),
            "realm": p.getRealm(),
        };
    }

    #! Builds the RFC 5929 \c tls-server-end-point GSSAPI channel-binding application data as a hex-encoded string
    /** The returned string is ready to assign to
        @ref Qore::Krb5::GssClientContextOptions::channel_binding_application_data_hex.
        Per
        <a href="https://datatracker.ietf.org/doc/html/rfc5929#section-4">RFC
        5929 §4</a>, the value is the ASCII constant
        \c "tls-server-end-point:" followed by the hash of the server
        certificate computed with the hash algorithm used in the certificate
        signature (or SHA-256 when the signature uses MD5 or SHA-1), both
        concatenated as a byte string. This function takes that hash as a
        hex string and returns the full hex-encoded binding data.

        @par Example:
        @code{.py}
# server_cert_hash_hex is the hex of the TLS server certificate hash
# computed per RFC 5929 §4.1.
string cb = Krb5Util::buildTlsServerEndPointChannelBindingHex(server_cert_hash_hex);

hash<Qore::Krb5::GssClientContextOptions> opts();
opts.channel_binding_application_data_hex = cb;
Qore::Krb5::GssClientContext ctx("LDAP/ad.example.com@EXAMPLE.COM", opts);
        @endcode

        @param server_cert_hash_hex the TLS server certificate hash as a
        hex string, computed per
        <a href="https://datatracker.ietf.org/doc/html/rfc5929#section-4.1">RFC
        5929 §4.1</a>

        @return a hex-encoded string that is the concatenation of the ASCII
        prefix \c "tls-server-end-point:" and \a server_cert_hash_hex

        @throw KRB5-CHANNEL-BINDING-ERROR if \a server_cert_hash_hex is
        empty or is not valid hexadecimal
    */
    public string sub buildTlsServerEndPointChannelBindingHex(string server_cert_hash_hex) {
        if (!server_cert_hash_hex) {
            throw "KRB5-CHANNEL-BINDING-ERROR", "certificate hash hex cannot be empty";
        }
        if (server_cert_hash_hex.size() % 2) {
            throw "KRB5-CHANNEL-BINDING-ERROR", "certificate hash hex must have even length";
        }
        if (server_cert_hash_hex !~ /^[[:xdigit:]]+$/) {
            throw "KRB5-CHANNEL-BINDING-ERROR", "certificate hash contains non-hexadecimal characters";
        }

        # "tls-server-end-point:" in hex
        return "746c732d7365727665722d656e642d706f696e743a" + server_cert_hash_hex;
    }

    #! Encodes an ASN.1 DER length
    binary sub derLength(int len) {
        if (len < 0x80) {
            return binary(chr(len));
        }
        if (len <= 0xff) {
            return <81> + binary(chr(len));
        }
        if (len <= 0xffff) {
            return <82> + binary(chr(len >> 8)) + binary(chr(len & 0xff));
        }
        return <83> + binary(chr(len >> 16)) + binary(chr((len >> 8) & 0xff)) + binary(chr(len & 0xff));
    }

    #! Wraps data in an ASN.1 DER TLV (tag-length-value)
    binary sub derWrap(int tag, binary value) {
        return binary(chr(tag)) + derLength(value.size()) + value;
    }

    #! Wraps a hex-encoded GSSAPI token in an RFC 4178 SPNEGO NegTokenInit envelope and returns it as base64
    /** This builds an SPNEGO initial context token (RFC 2743 Section 3.1 /
        RFC 4178 Section 4.2.1) containing the Kerberos 5 mechanism OID
        and the provided GSS token as the mechToken field. The result is
        base64-encoded, ready for use in an HTTP
        \c "Authorization: Negotiate <base64>" header.

        @par Example:
        @code{.py}
%requires Krb5Util
%requires krb5

Qore::Krb5::GssClientContext initiator("HTTP/web.example.com@EXAMPLE.COM");
hash<Qore::Krb5::GssStepInfo> step = initiator.step();
string authHeader = "Negotiate " + Krb5Util::negotiateSpnegoToken(step.token);
        @endcode

        @param gss_token_hex hex-encoded GSSAPI token from GssClientContext::step()

        @return base64-encoded SPNEGO NegTokenInit envelope

        @throw KRB5-SPNEGO-ERROR if the input token is empty or invalid hex
    */
    public string sub negotiateSpnegoToken(string gss_token_hex) {
        if (!gss_token_hex.val()) {
            throw "KRB5-SPNEGO-ERROR", "GSS token cannot be empty";
        }
        if (gss_token_hex.size() % 2) {
            throw "KRB5-SPNEGO-ERROR", "GSS token hex must have even length";
        }
        if (gss_token_hex !~ /^[[:xdigit:]]+$/) {
            throw "KRB5-SPNEGO-ERROR", "GSS token contains non-hexadecimal characters";
        }

        binary mechToken = parse_hex_string(gss_token_hex);

        # SPNEGO OID 1.3.6.1.5.5.2 in DER: 06 06 2b 06 01 05 05 02
        binary spnegoOid = parse_hex_string("06062b0601050502");
        # Kerberos 5 OID 1.2.840.113554.1.2.2 in DER: 06 09 2a 86 48 86 f7 12 01 02 02
        binary krb5Oid = parse_hex_string("06092a864886f71201020200");

        # Build NegTokenInit SEQUENCE:
        #   [0] SEQUENCE { OID krb5 }        -- mechTypes
        #   [2] OCTET STRING { mechToken }   -- mechToken
        binary mechTypes = derWrap(0xa0, derWrap(0x30, krb5Oid));
        binary mechTokenField = derWrap(0xa2, derWrap(0x04, mechToken));
        binary negTokenInit = derWrap(0x30, mechTypes + mechTokenField);

        # Wrap in context [0] for NegotiationToken choice
        binary negToken = derWrap(0xa0, negTokenInit);

        # Build RFC 2743 Section 3.1 initial context token:
        #   APPLICATION[0] { OID spnego, NegotiationToken }
        binary innerToken = spnegoOid + negToken;
        binary applicationToken = derWrap(0x60, innerToken);

        return make_base64_string(applicationToken);
    }

    #! Parses a base64-encoded SPNEGO NegTokenResp and extracts the contained GSS response token as hex
    /** @par Example:
        @code{.py}
string gssHex = Krb5Util::parseSpnegoResponse(base64ResponseFromServer);
hash<Qore::Krb5::GssStepInfo> step = initiator.step(gssHex);
        @endcode

        @param base64_token base64-encoded SPNEGO response from HTTP
        \c "WWW-Authenticate: Negotiate <base64>"

        @return hex-encoded GSS token extracted from the responseToken field

        @throw KRB5-SPNEGO-ERROR if the token cannot be parsed or does not
        contain a responseToken
    */
    public string sub parseSpnegoResponse(string base64_token) {
        if (!base64_token.val()) {
            throw "KRB5-SPNEGO-ERROR", "SPNEGO response cannot be empty";
        }

        binary data;
        try {
            data = parse_base64_string(base64_token);
        } catch (hash<ExceptionInfo> ex) {
            throw "KRB5-SPNEGO-ERROR", sprintf("invalid base64: %s", ex.desc);
        }

        if (data.size() < 2) {
            throw "KRB5-SPNEGO-ERROR", "SPNEGO response too short";
        }

        # Expect NegotiationToken ::= CHOICE { negTokenResp [1] NegTokenResp }
        # NegTokenResp ::= SEQUENCE { ... [2] OCTET STRING responseToken ... }
        # We walk the DER structure to find the [2] context tag containing the token

        # The outer wrapper should be context [1] (NegTokenResp choice)
        int pos = 0;
        if (data[pos] != 0xa1) {
            throw "KRB5-SPNEGO-ERROR", sprintf("expected NegTokenResp (tag 0xa1), got 0x%02x",
                data[pos]);
        }
        ++pos;
        int seqLen;
        (seqLen, pos) = parseDerLength(data, pos);

        # Inside is a SEQUENCE
        if (data[pos] != 0x30) {
            throw "KRB5-SPNEGO-ERROR", sprintf("expected SEQUENCE (tag 0x30), got 0x%02x",
                data[pos]);
        }
        ++pos;
        int innerLen;
        (innerLen, pos) = parseDerLength(data, pos);
        int endPos = pos + innerLen;

        # Walk the SEQUENCE fields looking for [2] (responseToken)
        while (pos < endPos) {
            int tag = data[pos];
            ++pos;
            int fieldLen;
            (fieldLen, pos) = parseDerLength(data, pos);

            if (tag == 0xa2) {
                # Found responseToken — contains an OCTET STRING
                if (pos >= data.size() || data[pos] != 0x04) {
                    throw "KRB5-SPNEGO-ERROR", "responseToken field does not contain OCTET STRING";
                }
                ++pos;
                int tokenLen;
                (tokenLen, pos) = parseDerLength(data, pos);
                binary token = data.substr(pos, tokenLen);
                return make_hex_string(token);
            }
            pos += fieldLen;
        }

        throw "KRB5-SPNEGO-ERROR", "SPNEGO response does not contain a responseToken field";
    }

    #! Parses a DER length field and returns (length, newPosition)
    list<int> sub parseDerLength(binary data, int pos) {
        if (pos >= data.size()) {
            throw "KRB5-SPNEGO-ERROR", "unexpected end of DER data while parsing length";
        }
        int first = data[pos];
        ++pos;
        if (first < 0x80) {
            return (first, pos);
        }
        int numBytes = first & 0x7f;
        if (numBytes == 0 || numBytes > 3) {
            throw "KRB5-SPNEGO-ERROR", sprintf("unsupported DER length encoding (%d bytes)", numBytes);
        }
        int len = 0;
        for (int i = 0; i < numBytes; i++) {
            if (pos >= data.size()) {
                throw "KRB5-SPNEGO-ERROR", "unexpected end of DER data while parsing multi-byte length";
            }
            len = (len << 8) | data[pos];
            ++pos;
        }
        return (len, pos);
    }
}
