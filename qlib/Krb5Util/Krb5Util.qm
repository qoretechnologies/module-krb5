%modern

module Krb5Util {
    version = "0.1.0";
    desc = "Kerberos 5 and GSSAPI utility module";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

%requires krb5

/** @mainpage Krb5Util Module

    @section krb5utilintro Krb5Util Module Introduction

    The \c Krb5Util module provides small Qore-language helpers on top of the
    binary \c krb5 module. The utility module intentionally uses a distinct
    name from \c krb5 to avoid conflicts on case-insensitive filesystems.

    Binary classes and constants remain in the \c Qore::Krb5 namespace; helper
    functions are exported from the \c Krb5Util namespace.
*/

public namespace Krb5Util {
    public string sub getHostBasedServicePrincipal(string service, string host, string realm) {
        return sprintf("%s/%s@%s", service, host, realm);
    }
}
