%modern

module Krb5 {
    version = "0.1.0";
    desc = "Kerberos 5 and GSSAPI helper module";
    author = "Qore Technologies, s.r.o.";
    url = "https://qore.org";
    license = "MIT";
}

%requires krb5

/** @mainpage Krb5 Helper Module

    @section krb5helperintro Krb5 Helper Module Introduction

    The \c Krb5 module provides small Qore-language helpers on top of the
    binary \c krb5 module.
*/

public namespace Qore::Krb5 {
    public string sub getHostBasedServicePrincipal(string service, string host, string realm) {
        return sprintf("%s/%s@%s", service, host, realm);
    }
}

