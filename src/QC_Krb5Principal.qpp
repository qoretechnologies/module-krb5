#include "krb5-module.h"

//! Kerberos principal parser and inspector
/** @since krb5 0.1
*/
qclass Krb5Principal [arg=QoreKrb5Principal* principal; ns=Qore::Krb5; flags=final];

//! Parses a Kerberos principal string
/** @param principal_string a principal such as \c "HTTP/qorus.example.com@EXAMPLE.COM"
    @throw KRB5-PRINCIPAL-ERROR if the principal cannot be parsed
*/
Krb5Principal::constructor(string principal_string) {
    SimpleRefHolder<QoreKrb5Principal> p(new QoreKrb5Principal(principal_string->c_str(), xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_KRB5PRINCIPAL, p.release());
}

//! Creates an exact copy of the object
/**
*/
Krb5Principal::copy() {
    SimpleRefHolder<QoreKrb5Principal> p(new QoreKrb5Principal(*principal, xsink));
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_KRB5PRINCIPAL, p.release());
}

//! Returns the canonical principal string
/**
*/
string Krb5Principal::toString() [flags=CONSTANT] {
    return principal->toString(xsink);
}

//! Returns the realm portion of the principal
/**
*/
string Krb5Principal::getRealm() [flags=CONSTANT] {
    return principal->getRealm(xsink);
}

//! Returns the number of principal components before the realm
/**
*/
int Krb5Principal::getComponentCount() [flags=CONSTANT] {
    return principal->getComponentCount();
}

//! Returns the principal component at the given index
/**
*/
string Krb5Principal::getComponent(int idx) [flags=CONSTANT] {
    return principal->getComponent(idx, xsink);
}

//! Returns True if the other principal is equal to the current principal
/**
*/
bool Krb5Principal::equals(Krb5Principal[QoreKrb5Principal] other) [flags=CONSTANT] {
    return principal->equals(**other);
}

//! Returns the default realm from the local Kerberos configuration
/**
*/
static string Krb5Principal::getDefaultRealm() [flags=CONSTANT] {
    krb5_context ctx = nullptr;
    krb5_error_code rc = krb5_init_context(&ctx);
    if (rc) {
        krb5_raise_exception(xsink, nullptr, rc, "KRB5-INIT-ERROR", "initializing kerberos context");
        return QoreValue();
    }

    char* realm = nullptr;
    rc = krb5_get_default_realm(ctx, &realm);
    if (rc) {
        krb5_raise_exception(xsink, ctx, rc, "KRB5-REALM-ERROR", "getting default kerberos realm");
        krb5_free_context(ctx);
        return QoreValue();
    }

    QoreStringNode* rv = new QoreStringNode(realm);
    krb5_free_default_realm(ctx, realm);
    krb5_free_context(ctx);
    return rv;
}
